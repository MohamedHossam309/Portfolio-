---
import { navLinks, personalInfo } from '../../data/portfolio';
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-border-subtle bg-primary/80 backdrop-blur-xl" id="navbar">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="#home" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded border border-accent-red flex items-center justify-center bg-accent-red/5 group-hover:bg-accent-red/10 transition-colors">
          <span class="font-mono text-xs font-bold text-accent-red">{personalInfo.initials}</span>
        </div>
        <span class="font-mono text-sm text-text-primary hidden sm:inline">{personalInfo.shortName}</span>
      </a>

      <!-- Desktop nav -->
      <div class="desktop-nav relative hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link px-3 py-2 rounded-md font-mono text-xs text-text-muted hover:text-text-primary hover:bg-secondary transition-colors duration-200"
            data-section={link.href.replace('#', '')}
          >
            {link.label}
          </a>
        ))}
        <span id="desktop-nav-indicator" class="pointer-events-none absolute bottom-1 h-px rounded-full bg-accent-red opacity-0 transition-all duration-300"></span>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2 cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="block w-5 h-px bg-text-primary transition-all duration-300 origin-center" id="menu-line-1"></span>
        <span class="block w-5 h-px bg-text-primary transition-all duration-300" id="menu-line-2"></span>
        <span class="block w-5 h-px bg-text-primary transition-all duration-300 origin-center" id="menu-line-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-border-subtle bg-primary/95 backdrop-blur-xl">
    <div class="container mx-auto px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link block px-4 py-3 rounded-lg font-mono text-sm text-text-muted hover:text-text-primary hover:bg-secondary transition-colors duration-200"
          data-section={link.href.replace('#', '')}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>

  <div class="nav-progress-track" aria-hidden="true">
    <div id="nav-progress-bar" class="nav-progress-bar"></div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('menu-line-1');
  const line2 = document.getElementById('menu-line-2');
  const line3 = document.getElementById('menu-line-3');
  const desktopNav = document.querySelector('.desktop-nav');
  const desktopIndicator = document.getElementById('desktop-nav-indicator');
  const progressBar = document.getElementById('nav-progress-bar');
  const sections = Array.from(document.querySelectorAll('section[id]'));
  const navLinksEl = Array.from(document.querySelectorAll('.nav-link, .mobile-nav-link'));

  let isOpen = false;
  let activeSectionId = sections[0]?.id ?? 'home';

  btn?.addEventListener('click', () => {
    isOpen = !isOpen;
    menu?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));

    if (isOpen) {
      line1!.style.transform = 'rotate(45deg) translate(2px, 4px)';
      line2!.style.opacity = '0';
      line3!.style.transform = 'rotate(-45deg) translate(2px, -4px)';
    } else {
      line1!.style.transform = '';
      line2!.style.opacity = '1';
      line3!.style.transform = '';
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      line1!.style.transform = '';
      line2!.style.opacity = '1';
      line3!.style.transform = '';
    });
  });

  function updateIndicator(sectionId) {
    if (!desktopNav || !desktopIndicator) return;

    const activeDesktopLink = desktopNav.querySelector(`.nav-link[data-section="${sectionId}"]`);

    if (!(activeDesktopLink instanceof HTMLElement)) {
      desktopIndicator.style.opacity = '0';
      return;
    }

    const navRect = desktopNav.getBoundingClientRect();
    const linkRect = activeDesktopLink.getBoundingClientRect();

    desktopIndicator.style.opacity = '1';
    desktopIndicator.style.left = `${linkRect.left - navRect.left + 8}px`;
    desktopIndicator.style.width = `${Math.max(20, linkRect.width - 16)}px`;
  }

  function updateProgressBar() {
    if (!progressBar) return;

    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
    progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
  }

  function findActiveSectionId() {
    const probe = window.scrollY + window.innerHeight * 0.35;
    let currentId = sections[0]?.id ?? 'home';

    for (const section of sections) {
      const start = section.offsetTop;
      const end = start + section.offsetHeight;

      if (probe >= start && probe < end) {
        return section.id;
      }

      if (probe >= start) {
        currentId = section.id;
      }
    }

    return currentId;
  }

  function syncNavState() {
    activeSectionId = findActiveSectionId();

    navLinksEl.forEach((link) => {
      const isActive = link.getAttribute('data-section') === activeSectionId;
      link.classList.toggle('text-accent-red', isActive);
      link.classList.toggle('text-text-muted', !isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    updateIndicator(activeSectionId);
    updateProgressBar();
  }

  let isTicking = false;

  const requestSync = () => {
    if (isTicking) return;

    isTicking = true;
    requestAnimationFrame(() => {
      syncNavState();
      isTicking = false;
    });
  };

  syncNavState();

  window.addEventListener('scroll', requestSync, { passive: true });
  window.addEventListener('resize', requestSync);
  window.addEventListener('load', requestSync);
</script>
