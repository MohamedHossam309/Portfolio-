---
import SectionHeader from './SectionHeader.astro';
import ScrollReveal from '../react/ScrollReveal';
import { certifications, courses } from '../../data/portfolio';
import { Award, BookOpen, ExternalLink } from '@lucide/astro';
---

<section id="certifications" class="py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader title="Certifications" subtitle="Verified Credentials & Training" />

    <!-- Certifications -->
    <ScrollReveal client:visible className="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10" direction="up">
      {certifications.map((cert) => (
        <div class="glass-card glass-card-hover rounded-lg p-5 transition-colors duration-200">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-accent-red/10 flex items-center justify-center shrink-0">
              <Award class="w-5 h-5 text-accent-red" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold text-text-primary leading-snug">{cert.title}</h3>
              <p class="text-xs text-text-muted mt-1">{cert.issuer}</p>
              <p class="font-mono text-[10px] text-text-dark mt-1">{cert.date}</p>
              {cert.verifyUrl.startsWith('[') ? (
                <p class="font-mono text-[10px] text-text-dark mt-2 italic">{cert.verifyUrl}</p>
              ) : (
                <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-accent-cyan hover:text-accent-cyan/80 mt-2 transition-colors">
                  <ExternalLink class="w-3 h-3" />
                  Verify
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </ScrollReveal>

    <!-- Courses sub-section -->
    <ScrollReveal client:visible className="mt-8" direction="up" delay={0.08}>
      <div class="flex items-center gap-2 mb-4">
        <BookOpen class="w-4 h-4 text-accent-cyan" />
        <h3 class="font-mono text-sm text-text-primary uppercase tracking-wider">Completed Courses</h3>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {courses.map((course) => (
          <div class="flex items-center gap-3 px-4 py-3 bg-card border border-border-subtle rounded-lg hover:border-border-hover transition-colors duration-200">
            <div class="w-1.5 h-1.5 rounded-full bg-accent-cyan shrink-0"></div>
            <div class="min-w-0">
              <p class="text-sm text-text-primary truncate">{course.title}</p>
              <p class="font-mono text-[10px] text-text-dark">{course.provider} · {course.year}</p>
            </div>
          </div>
        ))}
      </div>
    </ScrollReveal>
  </div>
</section>
