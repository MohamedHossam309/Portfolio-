---
import SectionHeader from './SectionHeader.astro';
import Avatar from '../react/Avatar';
import ScrollReveal from '../react/ScrollReveal';
import { personalInfo, summary, missionStatement, education, securityProfile, languages } from '../../data/portfolio';
import { MapPin, GraduationCap, Target, Globe } from '@lucide/astro';
---

<section id="about" class="py-20 relative">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(220,38,38,0.04),transparent_50%)]"></div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeader title="About" subtitle="Security Profile & Background" />

    <div class="grid lg:grid-cols-5 gap-8">
      <!-- Left: Bio -->
      <ScrollReveal client:visible className="lg:col-span-3 space-y-6" direction="up">
        <!-- Mission -->
        <div class="glass-card rounded-lg p-6">
          <blockquote class="text-xl sm:text-2xl font-semibold text-text-primary leading-relaxed border-l-2 border-accent-red pl-4">
            &ldquo;{missionStatement}&rdquo;
          </blockquote>
        </div>

        <!-- Bio -->
        <div class="glass-card rounded-lg p-6 space-y-4">
          <p class="text-text-secondary leading-relaxed">{summary}</p>

          <div class="grid sm:grid-cols-2 gap-4 pt-2">
            <!-- Location -->
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-secondary border border-border-subtle flex items-center justify-center">
                <MapPin class="w-4 h-4 text-accent-red" />
              </div>
              <div>
                <p class="font-mono text-[10px] text-text-dark uppercase tracking-wider">Location</p>
                <p class="text-sm text-text-primary">{personalInfo.location}</p>
              </div>
            </div>

            <!-- Education -->
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-secondary border border-border-subtle flex items-center justify-center">
                <GraduationCap class="w-4 h-4 text-accent-cyan" />
              </div>
              <div>
                <p class="font-mono text-[10px] text-text-dark uppercase tracking-wider">Education</p>
                <p class="text-sm text-text-primary">{education.institution}</p>
                <p class="text-xs text-text-muted">Graduating {education.expectedGraduation}</p>
              </div>
            </div>
          </div>

          <!-- Languages -->
          <div class="flex items-center gap-3 pt-2">
            <div class="w-9 h-9 rounded-lg bg-secondary border border-border-subtle flex items-center justify-center">
              <Globe class="w-4 h-4 text-accent-cyan" />
            </div>
            <div>
              <p class="font-mono text-[10px] text-text-dark uppercase tracking-wider">Languages</p>
              <div class="flex gap-3">
                {languages.map((lang) => (
                  <span class="text-sm text-text-primary">
                    {lang.name} <span class="text-text-muted text-xs">— {lang.level}</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </ScrollReveal>

      <!-- Right: Security Profile Card -->
      <ScrollReveal client:visible className="lg:col-span-2 space-y-4" direction="left" delay={0.12}>
        <div class="glass-card scan-card rounded-lg p-6 space-y-5">
          <div class="flex items-center gap-3 mb-2">
            <Target class="w-5 h-5 text-accent-red" />
            <h3 class="font-mono text-sm text-text-primary uppercase tracking-wider">Security Profile</h3>
          </div>

          <!-- Avatar -->
          <div class="flex justify-center py-4">
            <Avatar size="about" client:load />
          </div>

          <!-- Profile fields -->
          <div class="space-y-3">
            <div>
              <p class="font-mono text-[10px] text-text-dark uppercase tracking-wider">Primary Focus</p>
              <p class="text-sm text-accent-red font-medium">{securityProfile.primaryFocus}</p>
            </div>
            <div>
              <p class="font-mono text-[10px] text-text-dark uppercase tracking-wider">Secondary Focus</p>
              <p class="text-sm text-text-primary">{securityProfile.secondaryFocus}</p>
            </div>
            <div>
              <p class="font-mono text-[10px] text-text-dark uppercase tracking-wider mb-1.5">Interests</p>
              <div class="flex flex-wrap gap-1.5">
                {securityProfile.interests.map((interest) => (
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-secondary border border-border-subtle text-text-muted">
                    {interest}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </div>
</section>
